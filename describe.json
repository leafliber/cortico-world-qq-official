{
  "tools": [
    {
      "name": "qqofficial_send_message",
      "description": "发送文本或 Markdown。replyTo/eventId 互斥；delivery 支持 auto、reply、proactive、wakeup。不传依据和 delivery 时主动发送；fallback=false 禁用格式或回复方式降级。",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "channel",
                  "dms"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "content": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ]
          },
          "replyTo": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "referenceId": {
            "type": "string"
          },
          "keyboard": {
            "type": "object"
          }
        },
        "required": [
          "target",
          "content"
        ],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送文本或 Markdown 消息。",
        "en": "Sends text or Markdown messages."
      }
    },
    {
      "name": "qqofficial_send_media",
      "description": "发送媒体；公开 url 与宿主管理的 log:/mem: blob 二选一，items 可批量发送至多 8 项。不接受本地 path。fileType: 1 图片、2 视频、3 语音、4 文件。语音自动转码。部分失败不会重发已成功项。",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "channel",
                  "dms"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "url": {
            "type": "string"
          },
          "blob": {
            "type": "string"
          },
          "fileType": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "fileName": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "replyTo": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "blob": {
                  "type": "string"
                },
                "fileType": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "fileName": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "fileType"
              ]
            }
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送图片、语音、视频或文件。",
        "en": "Sends images, voice, video or files."
      }
    },
    {
      "name": "qqofficial_stream_message",
      "description": "followModel=true 将下一轮公开正文自动发给指定 QQ target；调用后直接输出正文。带回复依据的 C2C 流式，主动通知和其他会话缓冲后发送。手动模式传 content，续片传 streamId，finish 默认 true。",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "channel",
                  "dms"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "content": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ]
          },
          "replyTo": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "reply",
              "proactive",
              "wakeup"
            ]
          },
          "fallback": {
            "type": "boolean"
          },
          "streamId": {
            "type": "string"
          },
          "finish": {
            "type": "boolean"
          },
          "followModel": {
            "type": "boolean"
          }
        },
        "required": [
          "target"
        ],
        "additionalProperties": false
      },
      "tags": [
        "speak"
      ],
      "summary": {
        "zh": "发送流式分片或自动转发下一轮回复正文。",
        "en": "Sends stream parts or forwards the next public reply."
      }
    },
    {
      "name": "qqofficial_delete_message",
      "description": "撤回指定会话中机器人发送的消息；平台决定权限和有效期。",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "channel",
                  "dms"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "messageId": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "messageId"
        ],
        "additionalProperties": false
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "撤回机器人发送的消息。",
        "en": "Recalls messages sent by the bot."
      }
    },
    {
      "name": "qqofficial_history",
      "description": "查询本 World 的事件历史，可按会话和游标筛选。messagesOnly=true 只返回入站消息；meta.attachmentRefs 列出已补全的稳定 attachmentId、索引及临时图片缓存状态。",
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "c2c",
                  "group",
                  "channel",
                  "dms"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "messagesOnly": {
            "type": "boolean"
          },
          "beforeCursor": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "读取当前机器人在 Core 中保存的事件历史。",
        "en": "Reads this bot’s event history stored by Core."
      }
    },
    {
      "name": "qqofficial_read_attachment",
      "description": "读取 QQ 附件：单独传 attachmentId（优先），或同时传消息 cursor、index。引用可加 quotedIndex，嵌套引用用 quotedPath，二者互斥。图片优先读临时缓存，其他情况只下载 QQ CDN；语音转为 WAV。失败返回 code 和可用附件定位信息。",
      "parameters": {
        "type": "object",
        "properties": {
          "attachmentId": {
            "type": "string",
            "pattern": "^qqa:[a-f0-9]{40}$"
          },
          "cursor": {
            "type": "integer",
            "minimum": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "quotedIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "quotedPath": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "required": [],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "attachmentId"
            ]
          },
          {
            "required": [
              "cursor",
              "index"
            ]
          }
        ]
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "按持久引用或消息游标读取附件，优先使用临时图片缓存。",
        "en": "Reads attachments by durable reference or message cursor, preferring cached images."
      }
    },
    {
      "name": "qqofficial_list_targets",
      "description": "列出本账号已知 QQ 会话目标、最近消息和主动接收状态。定时通知须保存准确 target，并在唤醒后以 delivery=proactive 发送。",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "查询已知 QQ 会话及主动接收状态。",
        "en": "Lists known QQ targets and proactive reception state."
      }
    },
    {
      "name": "qqofficial_ack_interaction",
      "description": "确认互动事件；code=0 成功、1 失败、2 太频繁、3 重复、4 无权限、5 仅管理员可操作。",
      "parameters": {
        "type": "object",
        "properties": {
          "interactionId": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "required": [
          "interactionId",
          "code"
        ],
        "additionalProperties": false
      },
      "tags": [
        "act"
      ],
      "summary": {
        "zh": "确认平台互动事件。",
        "en": "Acknowledges platform interactions."
      }
    }
  ],
  "events": [
    {
      "type": "qqofficial.message",
      "trigger": "debounce",
      "description": {
        "zh": "收到 QQ 消息，保留正文、会话和原始字段。",
        "en": "An incoming QQ message, with its target and original fields."
      }
    },
    {
      "type": "qqofficial.notice",
      "trigger": "debounce",
      "description": {
        "zh": "收到互动、关系变化或其他平台事件。",
        "en": "An interaction, relationship change or other platform event."
      }
    },
    {
      "type": "qqofficial.sent",
      "tags": [
        "speak"
      ],
      "description": {
        "zh": "平台接受发送请求的存档回执，不唤醒模型。",
        "en": "An archived send receipt; does not wake the model."
      }
    },
    {
      "type": "qqofficial.attempt",
      "description": {
        "zh": "发送前持久化的序号预留，不唤醒模型。",
        "en": "A sequence reservation persisted before sending; does not wake the model."
      }
    },
    {
      "type": "qqofficial.removed",
      "description": {
        "zh": "平台接受撤回请求的存档回执，不唤醒模型。",
        "en": "An archived recall receipt; does not wake the model."
      }
    },
    {
      "type": "qqofficial.acknowledged",
      "description": {
        "zh": "平台接受互动确认的存档回执，不唤醒模型。",
        "en": "An archived interaction acknowledgement; does not wake the model."
      }
    },
    {
      "type": "qqofficial.attachments",
      "description": {
        "zh": "重复消息的附件补充记录，只归档，不重复唤醒模型。",
        "en": "An archived attachment supplement for a duplicate message; does not wake the model."
      }
    }
  ],
  "prompts": [
    {
      "key": "worlds.qqofficial.envPrompt",
      "title": "环境提示词",
      "role": "envPrompt",
      "content": "{{qqofficial.environment}}\n"
    }
  ]
}
